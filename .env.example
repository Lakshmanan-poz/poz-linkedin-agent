# Database
# Migration connection used by scripts such as: npm run db:migrate
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Supabase public client access
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your_supabase_anon_key>

# App auth
JWT_SECRET=<long_random_secret>

# Supabase backend secret (server-side only)
SUPABASE_SECRET_KEY=<your_supabase_service_role_key>

# AI
OPENAI_API_KEY=<your_openai_api_key>


# xAI Grok — required for X/Twitter trend search and web research
XAI_API_KEY=<your_xai_api_key>


# E2B Code Interpreter — required for carousel PDF generation (sandbox Python execution)
E2B_API_KEY=<your_e2b_api_key>
